<comment>
problem   = wind tunnel in cylindrical coordinates
reference =
configure = --prob=windtunnel --coord=cylindrical

<job>
problem_id  = wt      # problem ID: basename of output filenames

<output1>
file_type   = hdf5       # VTK data dump
variable    = prim      #
dt          = 3600.0    # time increment between outputs
cartesian_vector = true

<time>
cfl_number  = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1        # cycle limit
tlim        = 36000.0      # time limit
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1         = 1024             # Number of zones in X1-direction
x1min       = 7.2e12           # minimum value of X1
x1max       = 7.2e13            # maximum value of X1
ix1_bc      = user           # Inner-X1 boundary condition flag
ox1_bc      = user           # Outer-X1 boundary condition flag
#x1rat       = 1.0219         # non-uniform grid ratio

nx2         = 256            # Number of zones in X2-direction
x2min       = 0.0             # minimum value of X2
x2max       = 1.5707963267948966 # 3.141592653589793 # 6.2831853071795862   # maximum value of X2
ix2_bc      = polar_wedge       # Inner-X2 boundary condition flag
ox2_bc      = reflecting       # Outer-X2 boundary condition flag

nx3         = 32              # Number of zones in X3-direction
x3min       = 0.0           # minimum value of X3
x3max       = 1.5707963267948966 # 6.2831853071795862            # maximum value of X3
ix3_bc      = periodic       # Inner-X3 boundary condition flag
ox3_bc      = periodic       # Outer-X3 boundary condition flag

#<meshblock>
#nx1 = 40
#nx2 = 40
#nx3 = 10

<hydro>
gamma           = 1.66666667

<problem>
v_max             = 2.0e9
ramPressureFactor = 1.0e-5
rho_ISM           = 6.31e-25
diode             = true
Mej               = 2.0e33
Eej               = 1.0e51

